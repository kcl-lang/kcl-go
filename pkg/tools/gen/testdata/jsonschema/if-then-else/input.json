{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://example.com/schemas/shipping.json",
	"type": "object",
	"properties": {
		"country": {
			"type": "string"
		},
		"currency": {
			"type": "string",
			"enum": ["USD", "EUR", "JPY"]
		},
		"price": {
			"type": "number"
		},
		"discount": {
			"type": "number",
			"minimum": 0
		}
	},
	"required": [
		"country",
		"currency",
		"price"
	],
	"if": {
		"properties": {
			"currency": {
				"const": "JPY"
			}
		}
	},
	"then": {
		"properties": {
			"price": {
				"type": "number",
				"minimum": 0,
				"maximum": 1000000
			}
		}
	},
	"else": {
		"properties": {
			"discount": {
				"type": "number",
				"maximum": 100
			}
		}
	}
}
